{
  "name": "GYANODAYA",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "adb uninstall com.gyanodaya.newapp || true && react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "web": "webpack serve --mode development --config webpack.config.js",
    "build-web": "webpack --mode production --config webpack.config.js",
    "debug-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleDebug && cd ..",
    "release-build": "cd android && ./gradlew clean  && ./gradlew assembleRelease && cd ..",
    "adb-build": "adb uninstall com.gyanodaya.newapp || true && cd android && ./gradlew clean  && ./gradlew assembleRelease && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/stack": "^7.10.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/redux-logger": "^3.0.13",
    "axios": "^1.18.0",
    "moment": "^2.30.1",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-shimmer-placeholder": "^2.0.9",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.3.0",
    "redux-logger": "^3.0.6",
    "redux-saga": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "20.1.3",
    "@react-native-community/cli-platform-android": "20.1.3",
    "@react-native-community/cli-platform-ios": "20.1.3",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-native-web": "^0.21.2",
    "eslint": "^10.5.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "prettier": "3.8.4",
    "react-dom": "^19.2.7",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.7",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
